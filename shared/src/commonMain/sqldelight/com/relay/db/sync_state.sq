CREATE TABLE sync_state (
    dialog_id            TEXT NOT NULL PRIMARY KEY,
    newest_synced_id     TEXT,
    oldest_loaded_id     TEXT,
    has_more_history     INTEGER NOT NULL DEFAULT 1
);

selectByDialog:
SELECT * FROM sync_state WHERE dialog_id = :dialogId;

insertIfAbsent:
INSERT OR IGNORE INTO sync_state(dialog_id) VALUES (:dialogId);

updateNewestSynced:
UPDATE sync_state SET newest_synced_id = :newestSyncedId WHERE dialog_id = :dialogId;

updateOldestLoaded:
UPDATE sync_state SET oldest_loaded_id = :oldestLoadedId, has_more_history = :hasMoreHistory WHERE dialog_id = :dialogId;

deleteByDialog:
DELETE FROM sync_state WHERE dialog_id = :dialogId;

deleteAll:
DELETE FROM sync_state;
