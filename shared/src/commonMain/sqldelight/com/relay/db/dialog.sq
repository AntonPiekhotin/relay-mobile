CREATE TABLE dialog (
    id               TEXT    NOT NULL PRIMARY KEY,
    type             TEXT    NOT NULL,
    title            TEXT,
    last_message_at  INTEGER,
    unread_count     INTEGER NOT NULL DEFAULT 0,
    peer_id          TEXT,
    peer_read_at     INTEGER,
    self_read_at     INTEGER,
    self_read_id     TEXT,
    self_read_sent   INTEGER NOT NULL DEFAULT 1
);

insertIfAbsent:
INSERT OR IGNORE INTO dialog(id, type, title, last_message_at, unread_count, peer_id)
VALUES (:id, :type, :title, :lastMessageAt, 0, :peerId);

upsertFromServer:
INSERT INTO dialog(id, type, title, last_message_at, unread_count, peer_id)
VALUES (:id, :type, :title, :lastMessageAt, 0, :peerId)
ON CONFLICT(id) DO UPDATE SET
    type = excluded.type,
    title = COALESCE(excluded.title, dialog.title),
    peer_id = COALESCE(excluded.peer_id, dialog.peer_id),
    last_message_at = MAX(COALESCE(dialog.last_message_at, 0), COALESCE(excluded.last_message_at, 0));

setTitle:
UPDATE dialog SET title = :title WHERE id = :id;

fillPeerIfMissing:
UPDATE dialog SET peer_id = :peerId WHERE id = :id AND peer_id IS NULL;

backfillPeersFromMessages:
UPDATE dialog
SET peer_id = (
    SELECT m.sender_id FROM message m
    WHERE m.dialog_id = dialog.id AND m.sender_id != :selfId
    ORDER BY m.created_at ASC, m.local_id ASC
    LIMIT 1
)
WHERE peer_id IS NULL;

selectUnnamed:
SELECT id, peer_id FROM dialog WHERE title IS NULL AND peer_id IS NOT NULL;

bumpLastMessageAt:
UPDATE dialog
SET last_message_at = MAX(COALESCE(last_message_at, 0), :ts)
WHERE id = :id;

selectAll:
SELECT * FROM dialog ORDER BY COALESCE(last_message_at, 0) DESC, id;

advancePeerRead:
UPDATE dialog SET peer_read_at = MAX(COALESCE(peer_read_at, 0), :readAt) WHERE id = :id;

advanceSelfRead:
UPDATE dialog
SET self_read_at = :readAt, self_read_id = :upToMessageId, self_read_sent = 0
WHERE id = :id AND COALESCE(self_read_at, 0) < :readAt;

applyRemoteSelfRead:
UPDATE dialog
SET self_read_at = :readAt, self_read_id = :upToMessageId, self_read_sent = 1
WHERE id = :id AND COALESCE(self_read_at, 0) < :readAt;

markSelfReadSent:
UPDATE dialog SET self_read_sent = 1 WHERE id = :id AND self_read_id = :upToMessageId;

selectUnsentReads:
SELECT id, self_read_id FROM dialog WHERE self_read_sent = 0 AND self_read_id IS NOT NULL;

selectAllWithPreview:
SELECT
    d.id,
    d.type,
    d.title,
    d.last_message_at,
    d.peer_id,
    d.peer_read_at,
    (SELECT COUNT(*) FROM message unread
     WHERE unread.dialog_id = d.id
       AND unread.sender_id != COALESCE(:selfId, unread.sender_id)
       AND unread.created_at > COALESCE(d.self_read_at, 0)) AS unread_count,
    m.text AS last_text,
    m.state AS last_state,
    m.sender_id AS last_sender_id,
    m.created_at AS last_created_at
FROM dialog d
LEFT JOIN message m ON m.local_id = (
    SELECT local_id FROM message
    WHERE dialog_id = d.id
    ORDER BY created_at DESC, local_id DESC
    LIMIT 1
)
ORDER BY COALESCE(d.last_message_at, 0) DESC, d.id;

selectById:
SELECT * FROM dialog WHERE id = :id;

selectIds:
SELECT id FROM dialog;

deleteAll:
DELETE FROM dialog;
